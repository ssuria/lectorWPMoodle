{{!
    @template block_wpnews/news_item

    WordPress news item template compatible with Bootstrap 4 and 5.
    Works with Moodle 4.5+ (Bootstrap 4) and Moodle 5.0+ (Bootstrap 5).

    Context variables required for this template:
    * title - Post title
    * link - Post URL
    * excerpt - Post excerpt
    * date - Formatted date
    * showdate - Boolean to show date
    * imageurl - Featured image URL
    * showimage - Boolean to show image
    * showexcerpt - Boolean to show excerpt
    * categories - Array of category objects
    * showcategories - Boolean to show categories
    * readmore - Read more text
    * layoutclass - CSS class for layout (list/grid)

    Example context (json):
    {
        "title": "My WordPress Post",
        "link": "https://example.com/post",
        "excerpt": "This is a post excerpt...",
        "date": "January 15, 2024",
        "showdate": true,
        "imageurl": "https://example.com/image.jpg",
        "showimage": true,
        "showexcerpt": true,
        "categories": [{"name": "News", "id": 1}],
        "showcategories": true,
        "readmore": "Read more",
        "layoutclass": "col-md-6"
    }
}}
<div class="wpnews-item-wrapper {{layoutclass}}">
    <article class="wpnews-item card h-100 shadow-sm">
        {{#showimage}}
        {{#imageurl}}
        <div class="wpnews-image position-relative overflow-hidden">
            <a href="{{{link}}}" target="_blank" rel="noopener noreferrer" class="d-block">
                <img src="{{{imageurl}}}" alt="{{title}}" class="card-img-top img-fluid" loading="lazy">
                <div class="wpnews-overlay position-absolute w-100 h-100"></div>
            </a>
        </div>
        {{/imageurl}}
        {{/showimage}}

        <div class="card-body d-flex flex-column">
            {{#showcategories}}
            {{#categories}}
            <div class="wpnews-categories mb-2">
                {{#.}}
                <span class="badge bg-primary rounded-pill me-1 mr-1">
                    <i class="fa fa-tag me-1 mr-1"></i>{{name}}
                </span>
                {{/.}}
            </div>
            {{/categories}}
            {{/showcategories}}

            <h5 class="card-title wpnews-title-heading">
                <a href="{{{link}}}" target="_blank" rel="noopener noreferrer" class="wpnews-title text-decoration-none">
                    {{title}}
                </a>
            </h5>

            {{#showdate}}
            <div class="wpnews-meta mb-2">
                <small class="text-muted d-flex align-items-center">
                    <i class="fa fa-calendar me-2 mr-2"></i>
                    <time class="wpnews-date">{{date}}</time>
                </small>
            </div>
            {{/showdate}}

            {{#showexcerpt}}
            {{#excerpt}}
            <p class="card-text wpnews-excerpt flex-grow-1">{{excerpt}}</p>
            {{/excerpt}}
            {{/showexcerpt}}

            <div class="wpnews-footer mt-auto pt-3">
                <a href="{{{link}}}" target="_blank" rel="noopener noreferrer"
                   class="btn btn-primary btn-sm wpnews-readmore">
                    {{readmore}}
                    <i class="fa fa-arrow-right ms-1 ml-1"></i>
                </a>
            </div>
        </div>
    </article>
</div>
