{{!
    @template block_wpnews/news_container

    WordPress news container template.

    Context variables required for this template:
    * isgrid - Boolean for grid layout
    * newsitems - Array of news items HTML

    Example context (json):
    {
        "isgrid": true,
        "newsitems": ["<div>...</div>", "<div>...</div>"]
    }
}}
<div class="block-wpnews-container {{#isgrid}}wpnews-grid row{{/isgrid}}{{^isgrid}}wpnews-list{{/isgrid}}">
    {{#newsitems}}
    {{{.}}}
    {{/newsitems}}
</div>
